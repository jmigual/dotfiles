{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": {{ printf "node \"%s/.codex/hooks/rtk.mjs\"" .chezmoi.homeDir | toJson }}
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "serena-hooks remind --client=codex" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "serena-hooks activate --client=codex" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "serena-hooks cleanup --client=codex" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "codegraph prompt-hook" }
        ]
      }
    ]
  }
}
