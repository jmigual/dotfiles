{{- /* chezmoi:modify-template */ -}}
{{- /* Merges shared Claude Code preferences into the local settings.json. Everything not set
       here (permission approvals, statusLine, plugins, autoMode environment...) stays local. */ -}}
{{- $local := fromJson (.chezmoi.stdin | default "{}") -}}
{{- $shared := fromJson `{
  "attribution": {"commit": "", "pr": "", "sessionUrl": false},
  "model": "opus[1m]",
  "effortLevel": "high",
  "modelSettings": {"claude-opus-5-5": {"effortLevel": "high"}},
  "permissions": {"defaultMode": "auto"},
  "worktree": {"baseRef": "head"},
  "dialogExpiry": "never",
  "autoUpdatesChannel": "latest",
  "env": {"ENABLE_CLAUDEAI_MCP_SERVERS": "false"},
  "enabledPlugins": {
    "engineering@synced": false,
    "cowork-plugin-management@synced": false,
    "frontend-design@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "understand-anything@understand-anything": false
  },
  "skillOverrides": {
    "context7-mcp": "off",
    "claude-api": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:xlsx": "off"
  }
}` -}}
{{- /* Managed hooks replace local entries with the same command; other local hooks are kept.
       Removed hooks are ones tool installers (`rtk init -g`, `codegraph install`) add locally:
       the RTK rewrite gets subagents' Bash calls blocked in auto mode, and CodeGraph's prompt
       hook costs tokens on every prompt. */ -}}
{{- $managedHooks := fromJson `{
  "PreToolUse": [
    {"matcher": "", "hooks": [{"type": "command", "command": "serena-hooks remind --client=claude-code"}]},
    {"matcher": "mcp__serena(-wt)?__.*", "hooks": [{"type": "command", "command": "serena-hooks auto-approve --client=claude-code"}]}
  ],
  "SessionStart": [{"matcher": "", "hooks": [{"type": "command", "command": "serena-hooks activate --client=claude-code"}]}],
  "SessionEnd": [{"matcher": "", "hooks": [{"type": "command", "command": "serena-hooks cleanup --client=claude-code"}]}]
}` -}}
{{- $dropCommands := list "rtk hook claude" "codegraph prompt-hook" -}}
{{- range $event, $entries := $managedHooks -}}
{{-   range $entries }}{{ range .hooks }}{{ $dropCommands = append $dropCommands .command }}{{ end }}{{ end -}}
{{- end -}}
{{- $hooks := dict -}}
{{- range $event, $entries := (get $local "hooks" | default dict) -}}
{{-   $kept := list -}}
{{-   range $entries -}}
{{-     $entry := . }}{{ $drop := false -}}
{{-     range .hooks }}{{ if has .command $dropCommands }}{{ $drop = true }}{{ end }}{{ end -}}
{{-     if not $drop }}{{ $kept = append $kept $entry }}{{ end -}}
{{-   end -}}
{{-   if $kept }}{{ $_ := set $hooks $event $kept }}{{ end -}}
{{- end -}}
{{- range $event, $entries := $managedHooks -}}
{{-   $_ := set $hooks $event (concat (get $hooks $event | default list) $entries) -}}
{{- end -}}
{{- $_ := set $local "hooks" $hooks -}}
{{ mergeOverwrite $local $shared | toPrettyJson }}
